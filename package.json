  ],
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "debounce-fn": "^6.0.0",
    "lit": "^3.0.0",
    "squirrelly": "^8.0.8"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-preset-env": "^10.1.1",
    "prettier": "^3.4.2",
    "rollup": "^4.28.1",
    "rollup-plugin-inject-process-env": "^1.3.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-postcss-lit": "^2.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "test": "vitest run",
    "test:visual": "npm run build && node scripts/visual-smoke.mjs",
